{
  "name": "bifrost-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build:tokens",
    "dev": "vite",
    "prebuild": "npm run build:tokens",
    "build": "vite build",
    "preview": "vite preview",
    "build:tokens": "tsx scripts/build-tokens.ts",
    "guard:tokens": "bash scripts/guard-tokens.sh",
    "test": "npm run build:tokens && vitest run",
    "typecheck": "npm run build:tokens && vue-tsc --noEmit",
    "prestorybook": "npm run build:tokens",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm run build:tokens && storybook build"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/schibsted-grotesk": "^5.2.0",
    "@mdi/js": "^7.4.47",
    "pinia": "^3.0.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/vue3-vite": "^10.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.0",
    "storybook": "^10.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.0.0"
  }
}
