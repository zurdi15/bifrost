# bifrost-agent — static Go binary on alpine + smartmontools.
# Cross-compiles on the build platform (CGO off), no QEMU needed.

FROM --platform=$BUILDPLATFORM golang:1.23-alpine AS build
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
WORKDIR /src
COPY agent/go.mod agent/go.sum ./
RUN go mod download
COPY agent/ ./
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags "-s -w -X main.version=$VERSION" \
    -o /out/bifrost-agent ./cmd/bifrost-agent

FROM alpine:3.21
RUN apk add --no-cache ca-certificates smartmontools
COPY --from=build /out/bifrost-agent /usr/local/bin/bifrost-agent
ENTRYPOINT ["bifrost-agent"]
