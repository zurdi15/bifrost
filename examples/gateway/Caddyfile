{
	# Email for Let's Encrypt expiry notices.
	email {$ACME_EMAIL}

	# Admin API for caddy-sync hot reloads; 2019 is not published to the host,
	# so it is reachable only from the compose network.
	admin :2019
}

# TLS via the Cloudflare DNS-01 challenge: certs are issued without any
# inbound port from the internet, which suits LAN/VPN-only homelabs. The
# generated vhosts import this snippet by name — keep it as `cloudflare_tls`
# even if you swap the DNS provider inside.
(cloudflare_tls) {
	tls {
		dns cloudflare {$CF_API_TOKEN}
		resolvers 1.1.1.1 8.8.8.8
	}
}

# ── Hand-written vhosts ─────────────────────────────────────────────────────
# Anything declared here always wins: caddy-sync skips these hostnames.
# The dashboard itself, on the apex:
{$DOMAIN} {
	import cloudflare_tls
	reverse_proxy {$HUB_UPSTREAM}
}

# ── Docker routes generated by caddy-sync, k8s fallthrough ──────────────────
# One site, one wildcard certificate. caddy-sync renders host-matched handle
# blocks into bifrost.d/ (they win over the bare fallthrough handle); anything
# unmatched can fall through to a cluster ingress controller if you have one.
*.{$DOMAIN} {
	import cloudflare_tls
	import /etc/caddy/bifrost.d/*.caddy
	handle {
		respond "no such service" 404
	}
}
