# ── bifrost-hub ──────────────────────────────────────────────────────────────
# Shared secret agents use on first contact. Generate one: openssl rand -hex 32
BIFROST_ENROLL_TOKEN=change-me

# Auto-approve enrolling agents (true) or hold them as 'pending' until approved
# from the UI (false).
BIFROST_AUTO_APPROVE=true

# Where SQLite files live inside the container (mount a volume here).
BIFROST_DATA_DIR=/data

# Bind address/port (container-internal).
BIFROST_HOST=0.0.0.0
BIFROST_PORT=8000

# Gateway domain for URL auto-derivation. When set, any Docker service with an
# unambiguous port (exactly one published TCP port, or a bifrost.port label)
# gets https://<container>.<domain> as its card URL and gateway route — no
# bifrost.url label needed. Opt out per container with bifrost.expose=false.
# Empty disables derivation entirely.
#BIFROST_SERVICE_DOMAIN=example.net

# Tailscale: an admin-API access token (Tailscale console → Settings → Keys)
# switches the Tailnet section on — an interactive device map with the
# reachability your ACL policy actually allows. The tailnet name defaults to
# "-" (the token's own tailnet); set it only if the token spans several.
#BIFROST_TAILSCALE_API_KEY=
#BIFROST_TAILSCALE_TAILNET=-

# ── bifrost-agent ────────────────────────────────────────────────────────────
# Hub base URL, as reachable FROM the node (http:// or https://).
BIFROST_AGENT_HUB_URL=http://hub.example:8000

# Must match the hub's BIFROST_ENROLL_TOKEN.
BIFROST_AGENT_ENROLL_TOKEN=change-me

# Optional friendly name; defaults to the host's hostname.
#BIFROST_AGENT_NODE_NAME=

# Metric collection interval in seconds (the hub can override it live).
#BIFROST_AGENT_METRICS_INTERVAL=10

# Node UI served by this host (a NAS dashboard, HAOS, …): the hub routes it
# through the gateway and shows it as a service card. URL optional — without
# it the hostname derives from the node name and the service domain.
#BIFROST_AGENT_UI_PORT=1253
#BIFROST_AGENT_UI_URL=

# Speedtest download target: a large file on a well-connected server near you
# (latency/upload always use Cloudflare anycast — your nearest PoP).
#BIFROST_AGENT_SPEEDTEST_URL=https://fsn1-speed.hetzner.com/10GB.bin
